# Sao chép file này thành .env.docker trước khi chạy Docker ở chế độ production.
APP_ENV=production
APP_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Tạo hai chuỗi khác nhau, tối thiểu 32 ký tự. Không commit giá trị thật.
JWT_SECRET=CHANGE_ME
INGEST_TOKEN=CHANGE_ME_TOO

# Tùy chọn: cấu hình LLM online hoặc Ollama trong backend/.env.
