# Sao chép thành .env rồi chỉnh. Để trống ELASTICSEARCH_URL / REDIS_URL để chạy nhanh không cần Docker.
DATABASE_URL=sqlite:///./phongoi.db
ELASTICSEARCH_URL=
REDIS_URL=
# Development only. Khi APP_ENV=production, hai giá trị phải khác nhau,
# dài ít nhất 32 ký tự và không được giữ giá trị mẫu này.
JWT_SECRET=hay-doi-chuoi-bi-mat-nay
INGEST_TOKEN=hay-doi-ma-ingest-nay

# LLM: ollama | gemini | openai | none (none = chỉ dùng bộ phân tích luật tiếng Việt)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=60

# LLM online (nhập sau). OPENAI_* dùng được cho mọi dịch vụ có API chuẩn OpenAI chính thức:
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Môi trường: development | production. Production không tự tạo bảng, không chấp nhận
# secret mặc định/yếu và không bao giờ trả liên kết đặt lại mật khẩu qua API.
APP_ENV=development
# Địa chỉ web, dùng để tạo liên kết trong email đặt lại mật khẩu.
APP_URL=http://localhost:5173
# Email (quên mật khẩu). Để trống SMTP_HOST thì bản phát triển hiển thị liên kết đặt lại ngay trên trang.
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<địa chỉ gmail>, SMTP_PASSWORD=<mật khẩu ứng dụng 16 ký tự>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Phòng Ơi <no-reply@phongoi.vn>
